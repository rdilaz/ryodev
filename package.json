{
  "name": "ryodev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phone-oriented AI coding-session dashboard: demo fixtures plus live mode via machine hooks and a Cloudflare Worker",
  "scripts": {
    "start": "node scripts/preview.mjs",
    "preview:browser": "node scripts/open-browser.mjs",
    "test": "node --test tests/model.test.mjs tests/live.test.mjs tests/worker.test.mjs tests/hook.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify:live": "node scripts/verify-site.mjs",
    "check": "npm test && npm run test:browser && npm run test:deployment",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
